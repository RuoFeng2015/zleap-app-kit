{
  "name": "zleap-app-kit",
  "private": true,
  "version": "0.10.0",
  "description": "zleapOS 云开发应用工具集：npx 脚手架 create-zleap-app、CLI npm 分发 @zleap-ai/app-cli、前端 SDK @zleap-ai/app-sdk、AI 编程工具 skills",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "build:sdk": "node scripts/build-sdk.mjs",
    "sync:refs": "node scripts/sync-skill-references.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "check": "node scripts/sync.mjs --check",
    "test": "node --test test/*.test.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "release": "node scripts/release.mjs",
    "release:approve": "node scripts/release.mjs --approve-only",
    "publish:direct": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@npmcli/agent": "2.2.2",
    "@npmcli/config": "8.3.4",
    "esbuild": "0.25.12",
    "npm-profile": "10.0.0",
    "npm-registry-fetch": "17.1.0"
  },
  "overrides": {
    "encoding": "0.1.13"
  }
}
